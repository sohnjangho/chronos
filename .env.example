# 복사해서 .env 로 쓴다. 실제 값은 커밋하지 않는다.
# 아래 예시 값을 그대로 두면 서버가 뜨지 않는다. 반드시 바꾼다.
# 첫 관리자 계정 (처음 실행할 때 한 번 만든다). 비밀번호는 8자 이상, 72바이트 이하
CHRONOS_ADMIN_ID=admin
CHRONOS_ADMIN_PASSWORD=change-me
# 로그인 토큰 서명·API 키 암호화 열쇠. 32자 이상 (예: openssl rand -hex 32 의 출력)
CHRONOS_SECRET_KEY=change-me-to-a-long-random-string
# LLM 키는 여기에 넣지 않는다. 실행한 뒤 화면의 설정 > LLM 연결에서 입력한다.
